# ---------------------------------------------------------------------------
# Webmosh environment variables. Copy to `.env` and fill in real values.
# ---------------------------------------------------------------------------

# Auth (Better Auth, Google-only)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Database (Postgres)
DATABASE_URL=

# File storage (S3 / Cloudflare R2)
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Webmosh <noreply@webmosh.com>"
ADMIN_EMAIL=info@webmosh.com
APP_URL=https://app.webmosh.com

# AI Agent (Anthropic Claude)
# Encrypts integration API keys at rest (AES-256-GCM). REQUIRED for the AI Agent
# to store a key entered in Settings. Use a long random string.
SETTINGS_ENCRYPTION_KEY=
# Optional fallback Anthropic API key. A key saved in Settings → AI Agent takes
# priority; this env var is only used if no key is stored in the database.
ANTHROPIC_API_KEY=
# Optional model override. The model chosen in Settings → AI Agent takes
# priority; this is only a fallback when no model has been selected there.
# ANTHROPIC_MODEL=claude-haiku-4-5
